pkgname=ciwatch
pkgver=0.2.0
pkgrel=1
pkgdesc='Live GitHub Actions status and logs for one repository'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('github-cli: talks to GitHub (any gh on PATH or in mise works too)'
            'libnotify: desktop notifications when a run finishes')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ciwatch "$pkgdir/usr/bin/ciwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ciwatch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ciwatch.svg"
  install -Dm644 "$startdir/ciwatch.desktop" "$pkgdir/usr/share/applications/ciwatch.desktop"
}
